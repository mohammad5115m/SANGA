# Development defaults. Copy to .env for local work.
#
# These are NOT production values, and production will refuse to start on
# several of them — see docs/deployment.md §3. That refusal is deliberate: a
# development .env left in place on a real host used to boot happily and log
# every login code to disk.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Use "sqlite" for simplest local runs without Docker/Postgres.
# Use "postgres" with Docker Compose or a local PostgreSQL instance.
DJANGO_DATABASE=sqlite
POSTGRES_DB=sanga
POSTGRES_USER=sanga
POSTGRES_PASSWORD=sanga
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# "console" logs the OTP instead of sending it. Production rejects it unless
# SMS_ALLOW_UNDELIVERED is set, because a deployment whose codes go nowhere is
# one where nobody can log in and every code is sitting in a log file.
SMS_PROVIDER=console
# SMS_ALLOW_UNDELIVERED=false

DEFAULT_FROM_EMAIL=noreply@sanga.local

USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Content-Security-Policy. Report-only first on a live site; see
# apps/core/middleware.py. Add the object-storage origin here when USE_S3 is on,
# or product images are blocked.
# CSP_REPORT_ONLY=false
# CSP_IMG_SRC=https://media.example.com
# CSP_MEDIA_SRC=https://media.example.com
