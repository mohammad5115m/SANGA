DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Use "sqlite" for simplest local runs without Docker/Postgres.
# Use "postgres" with Docker Compose or a local PostgreSQL instance.
DJANGO_DATABASE=sqlite
POSTGRES_DB=sanga
POSTGRES_USER=sanga
POSTGRES_PASSWORD=sanga
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SMS_PROVIDER=console
DEFAULT_FROM_EMAIL=noreply@sanga.local
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
