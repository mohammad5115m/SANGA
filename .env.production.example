# Reference only: enter real values in the hosting dashboard, never commit .env.
# Blank credentials intentionally prevent this template from serving users.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=sangesfahan.com,www.sangesfahan.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sangesfahan.com,https://www.sangesfahan.com
DJANGO_DATABASE=postgres
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
SANGA_LOGIN_PHONE_ALLOWLIST=
SANGA_REQUIRE_VERIFIED_FOR_NETWORK=true
SANGA_MVP_NAVIGATION=false

# Copy the managed Redis URL from its dashboard. Keep it on the private network.
REDIS_URL=
CACHE_URL=
# No worker/beat is needed for the current synchronous business workflows.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

SMS_PROVIDER=kavenegar
SMS_ALLOW_UNDELIVERED=false
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=sanga-otp
SMS_TIMEOUT_SECONDS=10

USE_S3=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Keep the whole bucket private: invoices and signatures share this storage.
# Use the exact object-serving origin supplied by the provider, not a wildcard.
CSP_IMG_SRC=
CSP_MEDIA_SRC=
CSP_REPORT_ONLY=false

# Verify the host's proxy chain before changing this safe default.
SANGA_TRUSTED_PROXY_COUNT=0
SECURE_SSL_REDIRECT=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
PORT=8000
INVOICE_EXPORTS_PER_MINUTE=6
INVOICE_EXPORT_MAX_BYTES=26214400
INVOICE_EXPORT_MAX_PAGES=20
INVOICE_IMAGE_DPI=200
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
