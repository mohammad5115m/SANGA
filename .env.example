# Development defaults. Copy to .env for local work.
#
# These are NOT production values, and production will refuse to start on
# several of them — see docs/deployment.md §3. That refusal is deliberate: a
# development .env left in place on a real host used to boot happily and log
# every login code to disk.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Use "sqlite" for simplest local runs without Docker/Postgres.
# Use "postgres" with Docker Compose or a local PostgreSQL instance.
DJANGO_DATABASE=sqlite
POSTGRES_DB=sanga
POSTGRES_USER=sanga
POSTGRES_PASSWORD=sanga
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# "console" logs the OTP instead of sending it. Production rejects it unless
# SMS_ALLOW_UNDELIVERED is set, because a deployment whose codes go nowhere is
# one where nobody can log in and every code is sitting in a log file.
SMS_PROVIDER=console
# SMS_ALLOW_UNDELIVERED=false

DEFAULT_FROM_EMAIL=noreply@sanga.local

# Uploaded media. Object storage is the supported production strategy, and
# production refuses to start with USE_S3=false unless the local-media mode below
# is asked for by name — see docs/deployment.md §4.
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# One of these two is required when USE_S3=true. Iranian object stores generally
# need the endpoint rather than a region.
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Set instead of the key pair when the host supplies credentials itself.
# AWS_S3_USE_IAM_ROLE=false

# The deliberate alternative: keep media on a persistent volume. Requires BOTH
# of these, plus a reverse proxy serving /media/ from that volume — Django does
# not serve it with DEBUG=False.
# SANGA_ALLOW_LOCAL_MEDIA=true
# SANGA_MEDIA_ROOT=/app/media

# Content-Security-Policy. Report-only first on a live site; see
# apps/core/middleware.py. Required when USE_S3 is on: media served from another
# origin is blocked unless that origin is listed, and the symptom looks like
# missing data rather than a header.
# CSP_REPORT_ONLY=false
# CSP_IMG_SRC=https://media.example.com
# CSP_MEDIA_SRC=https://media.example.com
